rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Closed project: sign-up is disabled in the Auth console, so "signed in"
    // means one of the team members. Everyone reads everything; each user
    // writes only under their own uid.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /days/{day} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
